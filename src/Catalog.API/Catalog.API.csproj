<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>d1b521ec-3411-4d39-98c6-8509466ed471</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ActivityExtensions.cs" Link="Extensions\ActivityExtensions.cs" />
    <Compile Include="..\Shared\MigrateDbContextExtensions.cs" Link="Extensions\MigrateDbContextExtensions.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <!-- Committed OpenAPI JSON is authoritative; on-build getdocument hangs under some agent/toolchain setups. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- AI -->
  <ItemGroup>
    <PackageReference Include="Aspire.Azure.AI.OpenAI" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventBusRabbitMQ\EventBusRabbitMQ.csproj" />
    <ProjectReference Include="..\IntegrationEventLogEF\IntegrationEventLogEF.csproj" />
    <ProjectReference Include="..\eShop.ServiceDefaults\eShop.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Pics\*.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Catalog.FunctionalTests" />
    <InternalsVisibleTo Include="Catalog.UnitTests" />
  </ItemGroup>

  <!-- Rust catalog cdylib (stock rules) — built and copied next to the host. -->
  <PropertyGroup>
    <CatalogNativeStageDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\native\catalog'))</CatalogNativeStageDir>
  </PropertyGroup>

  <Target Name="BuildCatalogNative" BeforeTargets="BeforeBuild" Condition="'$(SkipCatalogNativeBuild)' != 'true'">
    <PropertyGroup>
      <_CatalogNativeScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\build-catalog-native.sh'))</_CatalogNativeScript>
    </PropertyGroup>
    <MakeDir Directories="$(CatalogNativeStageDir)" />
    <Exec Command="bash &quot;$(_CatalogNativeScript)&quot; &quot;$(CatalogNativeStageDir)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\.."
          Condition="Exists('$(_CatalogNativeScript)')" />
  </Target>

  <Target Name="CopyCatalogNativeToOutput" AfterTargets="BuildCatalogNative;CopyFilesToOutputDirectory" BeforeTargets="AfterBuild" Condition="'$(SkipCatalogNativeBuild)' != 'true'">
    <ItemGroup>
      <_CatalogNativeLibs Include="$(CatalogNativeStageDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CatalogNativeLibs)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_CatalogNativeLibs)' != ''" />
    <Copy SourceFiles="@(_CatalogNativeLibs)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and '@(_CatalogNativeLibs)' != '' and Exists('$(PublishDir)')" />
  </Target>

  <!-- Flow staged cdylib to ProjectReference outputs (WAF / test hosts). -->
  <Target Name="IncludeCatalogNativeInCopyToOutputDirectoryItems"
          BeforeTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(SkipCatalogNativeBuild)' != 'true'">
    <ItemGroup>
      <_CatalogNativeLibsForDeps Include="$(CatalogNativeStageDir)\*" />
      <ContentWithTargetPath Include="@(_CatalogNativeLibsForDeps)" Condition="'@(_CatalogNativeLibsForDeps)' != ''">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

</Project>


