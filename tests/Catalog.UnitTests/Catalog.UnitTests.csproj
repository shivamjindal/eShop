<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Catalog.API\Catalog.API.csproj" />
  </ItemGroup>

  <!-- Ensure Rust cdylib is beside the test host for P/Invoke. -->
  <Target Name="CopyCatalogNativeToTests" AfterTargets="Build">
    <PropertyGroup>
      <_CatalogNativeOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\native\catalog'))</_CatalogNativeOut>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_CatalogNativeOut)')">
      <_CatalogNativeLibs Include="$(_CatalogNativeOut)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CatalogNativeLibs)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'@(_CatalogNativeLibs)' != ''" />
  </Target>

</Project>
