<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateErrorForMissingTargetingPacks>false</GenerateErrorForMissingTargetingPacks>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Catalog.API\Catalog.API.csproj" />
  </ItemGroup>

  <!-- Ensure the Rust cdylib sits next to the test host (Catalog.API builds it). -->
  <PropertyGroup>
    <NativeCatalogRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\native'))</NativeCatalogRoot>
    <NativeCatalogLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(NativeCatalogRoot)\target\release\catalog.dll</NativeCatalogLib>
    <NativeCatalogLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(NativeCatalogRoot)/target/release/libcatalog.dylib</NativeCatalogLib>
    <NativeCatalogLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(NativeCatalogRoot)/target/release/libcatalog.so</NativeCatalogLib>
  </PropertyGroup>

  <Target Name="CopyCatalogNativeToTestOutput" AfterTargets="Build">
    <Copy SourceFiles="$(NativeCatalogLib)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(NativeCatalogLib)')" />
  </Target>

</Project>
